@model WebApplication1.Models.ContactInfo

<h2 style="text-align:center;">Add Contact</h2>

<form method="post" style="width:300px; margin:auto;">

    <div style="margin-bottom:10px;">
        <input type="number" name="ContactId" placeholder="ID" required style="width:100%; padding:5px;" />
    </div>

    <div style="margin-bottom:10px;">
        <input type="text" name="FirstName" placeholder="First Name" required style="width:100%; padding:5px;" />
    </div>

    <div style="margin-bottom:10px;">
        <input type="text" name="LastName" placeholder="Last Name" required style="width:100%; padding:5px;" />
    </div>

    <div style="margin-bottom:10px;">
        <input type="text" name="CompanyName" placeholder="Company" style="width:100%; padding:5px;" />
    </div>

    <div style="margin-bottom:10px;">
        <input type="email" name="EmailId" placeholder="Email" style="width:100%; padding:5px;" />
    </div>

    <div style="margin-bottom:10px;">
        <input type="number" name="MobileNo" placeholder="Mobile" style="width:100%; padding:5px;" />
    </div>

    <div style="margin-bottom:10px;">
        <input type="text" name="Designation" placeholder="Designation" style="width:100%; padding:5px;" />
    </div>

    <div style="text-align:center;">
        <button type="submit" style="padding:6px 15px; background-color:blue; color:white; border:none;">
            Save
        </button>
    </div>

</form>