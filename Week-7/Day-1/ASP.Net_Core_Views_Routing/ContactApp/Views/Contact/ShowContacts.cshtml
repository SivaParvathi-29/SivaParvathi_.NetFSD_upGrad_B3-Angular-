@model List<WebApplication1.Models.ContactInfo>

<h2 class="text-center">Contact List</h2>

<div class="container mt-3">
    <a href="/Contact/AddContact" class="btn btn-success mb-3">Add Contact</a>

    <table class="table table-bordered table-striped">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Company</th>
            <th>Email</th>
            <th>Mobile</th>
            <th>Designation</th>
            <th>Search</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ContactId</td>
                <td>@item.FirstName @item.LastName</td>
                <td>@item.CompanyName</td>
                <td>@item.EmailId</td>
                <td>@item.MobileNo</td>
                <td>@item.Designation</td>
                <td>
                    <a href="/Contact/GetContactById/@item.ContactId" class="btn btn-info btn-sm">View</a>
                </td>
            </tr>
        }
    </table>
</div>