<h2>Student Registration</h2>

<form method="post" action="/student/submit">

    <p>
        Name:<br />
        <input type="text" name="name" />
    </p>

    <p>
        Age:<br />
        <input type="number" name="age" />
    </p>

    <p>
        Course:<br />
        <input type="text" name="course" />
    </p>

    <button type="submit">Submit</button>

</form>