@model List<ProductApp1.Models.Product>

<h2 class="text-center mt-4">Product List</h2>

<div class="container mt-4">
    <a href="/Product/Create" class="btn btn-success mb-3">Add Product</a>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
                <th>Category</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductId</td>
                    <td>@item.ProductName</td>
                    <td>@item.Price</td>
                    <td>@item.Category</td>
                    <td>
                        <a href="/Product/Details/@item.ProductId" class="btn btn-info btn-sm">Details</a>
                        <a href="/Product/Edit/@item.ProductId" class="btn btn-warning btn-sm">Edit</a>
                        <a href="/Product/Delete/@item.ProductId" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>