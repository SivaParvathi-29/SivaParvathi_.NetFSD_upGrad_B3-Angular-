@{
}

@model List<WebApplication3.Models.ContactInfo>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Contact List</h2>
        <a href="/Contact/AddContact" class="btn btn-primary">+ Add Contact</a>
    </div>

    <div class="card shadow">
        <div class="card-body">

            <table class="table table-bordered table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>Company</th>
                        <th>Department</th>
                        <th style="width:180px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FirstName @item.LastName</td>
                            <td>@item.EmailId</td>
                            <td>@item.MobileNo</td>
                            <td>@item.CompanyName</td>
                            <td>@item.DepartmentName</td>
                            <td>
                                <a href="/Contact/EditContact/@item.ContactId"
                                   class="btn btn-warning btn-sm me-1">Edit</a>

                                <a href="/Contact/DeleteContact/@item.ContactId"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Are you sure you want to delete this contact?')">
                                    Delete
                                </a>
                                <a href="/Contact/Details/@item.ContactId" class="btn btn-info btn-sm">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

</div>