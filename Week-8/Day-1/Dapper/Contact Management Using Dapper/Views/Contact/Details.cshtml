@{
}

@model WebApplication3.Models.ContactInfo

<div class="container mt-5">

    <div class="card shadow p-4">

        <h2 class="text-primary mb-4">Contact Details</h2>

        <div class="row mb-3">
            <div class="col-md-6">
                <strong>First Name:</strong>
                <p>@Model.FirstName</p>
            </div>
            <div class="col-md-6">
                <strong>Last Name:</strong>
                <p>@Model.LastName</p>
            </div>
        </div>

        <div class="mb-3">
            <strong>Email:</strong>
            <p>@Model.EmailId</p>
        </div>

        <div class="mb-3">
            <strong>Mobile:</strong>
            <p>@Model.MobileNo</p>
        </div>

        <div class="mb-3">
            <strong>Designation:</strong>
            <p>@Model.Designation</p>
        </div>

        <div class="mb-3">
            <strong>Company:</strong>
            <p>@Model.CompanyName</p>
        </div>

        <div class="mb-3">
            <strong>Department:</strong>
            <p>@Model.DepartmentName</p>
        </div>

        <div class="mt-4">
            <a href="/Contact/EditContact/@Model.ContactId" class="btn btn-warning">Edit</a>
            <a href="/Contact/ShowContacts" class="btn btn-secondary">Back</a>
        </div>

    </div>

</div>